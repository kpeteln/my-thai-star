            { "name": "restServiceRoot$", "type": "Observable<string>", "modifiers": ["private","readonly"],
              "initialValue": "this.config.getRestServiceRoot()" }
          ],
          "constructor": {
            "parameters": [
              { "name": "http", "type": "HttpClient", "modifiers": ["private"] },
              { "name": "config", "type": "ConfigService", "modifiers": ["private"] }
            ]
          },
          "methods": [
            {
              "name": "postBooking", "modifiers": ["public"], "returnType": "Observable<BookingResponse>",
              "parameters": [{ "name": "bookInfo", "type": "BookingInfo" }],
              "body": [
                { "type": "ReturnStatement", "value": {
                  "type": "MethodInvocation", "target": "this.restServiceRoot$", "methodName": "pipe",
                  "arguments": [{
                    "type": "MethodInvocation", "methodName": "exhaustMap",
                    "arguments": [{ "type": "LambdaExpression", "parameters": ["restServiceRoot"],
                      "body": [{ "type": "ReturnStatement", "value": {
